#!/bin/bash

# postinstall runs as root — resolve the actual logged-in user
ACTUAL_USER=$(stat -f "%Su" /dev/console)
ACTUAL_UID=$(id -u "$ACTUAL_USER")
ACTUAL_HOME=$(eval echo ~"$ACTUAL_USER")

APP_SUPPORT="$ACTUAL_HOME/Library/Application Support/RestartReminder"
PLIST="$ACTUAL_HOME/Library/LaunchAgents/com.tanzimk.restartreminder.plist"

mkdir -p "$APP_SUPPORT"
chown "$ACTUAL_USER" "$APP_SUPPORT"

# Only copy default config if one doesn't exist — preserves user's settings on upgrade
if [ ! -f "$APP_SUPPORT/config.json" ]; then
    cp "/Applications/RestartReminder.app/Contents/Resources/config.json" "$APP_SUPPORT/"
    chown "$ACTUAL_USER" "$APP_SUPPORT/config.json"
fi

cp "/Applications/RestartReminder.app/Contents/Resources/com.tanzimk.restartreminder.plist" "$PLIST"
chown "$ACTUAL_USER" "$PLIST"

# Unload first in case this is an upgrade, then load for the actual user
launchctl asuser "$ACTUAL_UID" launchctl bootout "gui/$ACTUAL_UID" "$PLIST" 2>/dev/null || true
launchctl asuser "$ACTUAL_UID" launchctl bootstrap "gui/$ACTUAL_UID" "$PLIST"
